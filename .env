# --- Downstream service URLs (Section 3) ---
EMOTION_SERVICE_URL=http://localhost:8101
SPEECH_SERVICE_URL=http://localhost:8102
LLM_SERVICE_URL=http://localhost:8103

# Which of A, B, D to run as mocks. Empty string = all real.
USE_MOCKS=a,b,d

# --- Database ---
DATABASE_URL=mysql+pymysql://emotion_ai:emotion_ai@localhost:3306/emotion_ai
REDIS_URL=redis://localhost:6379/0

# --- Auth (Section 8.3) ---
JWT_SECRET=JENS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# --- Component-specific (owned by A, B, D — listed here for completeness) ---
EMOTION_MODEL_PATH=./models/fer_cnn_v3.pt
WHISPER_MODEL_SIZE=small
KOKORO_VOICE_DEFAULT=af_heart
LLM_MODEL_NAME=llama3.1:8b-instruct-q4_K_M
